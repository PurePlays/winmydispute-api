# Core runtime
NODE_ENV=development
PORT=3000
BASE_URL=https://your-domain.example

# GPT action auth
# Use either OPENAI_BEARER or OPENAI_BEARERS_JSON.
OPENAI_BEARER=replace-with-a-long-random-bearer
# OPENAI_BEARERS_JSON={"primary":"replace-with-rotated-token-1","secondary":"replace-with-rotated-token-2"}

# Stripe
STRIPE_SECRET_KEY=sk_live_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
CHECKOUT_PRODUCT_NAME=WinMyDispute Premium Dispute Kit
CHECKOUT_PRODUCT_DESCRIPTION=One-time unlock for the full WinMyDispute premium kit, including a dispute letter, evidence packet, exhibit index, rebuttal strategy, CFPB summary, and downloadable PDF or Word report.
CHECKOUT_PRODUCT_UNIT_LABEL=Dispute kit
# Optional public HTTPS image shown on Stripe Checkout
# CHECKOUT_PRODUCT_IMAGE_URL=https://your-domain.example/stripe-product.png

# Signed premium artifact downloads
ARTIFACT_TOKEN_SECRET=replace-with-a-different-long-random-secret
ARTIFACT_URL_TTL_MS=259200000

# Optional OCR
# OPENAI_API_KEY=sk-proj-replace-me
# OPENAI_OCR_MODEL=gpt-4.1-mini

# Optional observability
# SENTRY_DSN=

# Optional admin access
# ADMIN_API_TOKEN=replace-with-a-long-random-admin-token

# Optional persistence/storage overrides
# DATABASE_FILE_PATH=./mock-data/app.sqlite
# STORAGE_ROOT_DIR=./secure-storage
# EVIDENCE_UPLOADS_DIR=./tmp/evidence

# Optional rate limits
# CHECKOUT_RATE_LIMIT_MAX=20
# PREMIUM_RATE_LIMIT_MAX=120
# EVIDENCE_RATE_LIMIT_MAX=120
# JOBS_RATE_LIMIT_MAX=240
